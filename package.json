{
  "name": "sorgfaltbau",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prelint": "node scripts/patch-minimatch-brace-expansion.mjs",
    "postinstall": "node scripts/patch-minimatch-brace-expansion.mjs && prisma generate",
    "dev": "set NODE_OPTIONS=--max-old-space-size=4096&& next dev --webpack",
    "dev:turbo": "set NODE_OPTIONS=--max-old-space-size=4096&& next dev",
    "build": "prisma generate && set NODE_OPTIONS=--max-old-space-size=4096&& next build --webpack",
    "build:turbo": "prisma generate && set NODE_OPTIONS=--max-old-space-size=4096&& next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gsc:check": "node scripts/gsc-report.mjs check",
    "gsc:report": "node scripts/gsc-report.mjs report",
    "gsc:inspect": "node scripts/gsc-report.mjs inspect",
    "seo:check": "node scripts/check-public-seo.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.34.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.4.3",
    "next-intl": "^4.12.0",
    "nodemailer": "10.2.1",
    "pg": "^8.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intersection-observer": "^10.0.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "@hono/node-server": "1.19.17",
    "postcss": "8.5.31",
    "js-yaml": "4.3.2",
    "fast-uri": "3.1.9",
    "undici": "6.29.1",
    "browserslist": "4.29.4",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.7",
    "deepmerge-ts": "8.0.2",
    "zod": "4.6.7",
    "minimatch@3": {
      "brace-expansion": "5.0.12"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  }
}
